# IBM Quantum credentials for scripts 08 and 09.
# Copy to .env and fill in your own values, or set these as environment
# variables in the shell before running. Never commit the filled-in file.
#
#   PowerShell:  $env:IBM_API_KEY = "..."
#   bash:        export IBM_API_KEY="..."

IBM_API_KEY=your-api-token
IBM_INSTANCE=crn:v1:bluemix:public:quantum-computing:region:a/account:instance::
